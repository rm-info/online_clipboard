# Copy this to .env and fill in the values
# Never commit .env to version control

# Required — HMAC key for signed write tokens. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
CLIPBOARD_SERVER_SECRET=replace_with_64_hex_chars_generated_above

# Redis connection (leave as-is for docker-compose setup)
REDIS_URL=redis://redis:6379/0

# Session lifetime in seconds (default: 7200 = 2 hours)
SESSION_TTL_SECONDS=7200
FILE_MAX_SIZE_BYTES=104857600
SESSION_FILE_MAX_BYTES=1073741824
# Global disk budget across all sessions (default: 10 GiB)
TOTAL_FILE_MAX_BYTES=10737418240
# How often the background task purges expired session dirs from disk (seconds)
CLEANUP_INTERVAL_SECONDS=600
# /healthz returns 503 when disk usage ratio reaches this threshold (0.0–1.0)
HEALTHZ_WARN_RATIO=0.8
UPLOAD_ROOT=/tmp/online_clipboard_uploads

# Per-session failed auth proofs before the session is locked forever
SESSION_MAX_FAILED_ATTEMPTS=20

# Proof-of-work parameters (anti-spam for anonymous endpoints).
# 18 bits ≈ 262k SHA-256 attempts ≈ ~0.5s on a modern CPU.
POW_DIFFICULTY_BITS=18
POW_CHALLENGE_TTL_SECONDS=120

# Per-token write quotas (signed token replaces per-IP tracking).
# Set max to 0 or negative to disable.
WRITE_RATE_LIMIT_MAX=240
WRITE_RATE_LIMIT_WINDOW_SECONDS=3600

# Debug mode (set to false in production)
DEBUG=false
